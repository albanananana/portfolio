{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bondata-editorial",
      "destination": "/bondata",
      "permanent": true
    },
    {
      "source": "/bondata-editorial.html",
      "destination": "/bondata",
      "permanent": true
    }
  ]
}
